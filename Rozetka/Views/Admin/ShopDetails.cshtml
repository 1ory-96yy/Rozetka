@model BLL.DTOs.ShopDetailsDto
@{
    ViewData["Title"] = "Магазин: " + Model.Name;
}

<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="admin-logo"><i class="fa-solid fa-store"></i> ROZETKA</div>
        <nav class="admin-nav">
            <a asp-action="Index" asp-route-tab="products" class="admin-nav-link"><i class="fa-solid fa-box"></i> Товари</a>
            <a asp-action="Index" asp-route-tab="categories" class="admin-nav-link"><i class="fa-solid fa-list"></i> Категорії</a>
            <a asp-action="Index" asp-route-tab="orders" class="admin-nav-link"><i class="fa-solid fa-cart-shopping"></i> Замовлення</a>
            <a asp-action="Index" asp-route-tab="users" class="admin-nav-link"><i class="fa-solid fa-users"></i> Користувачі</a>
            <a asp-action="Index" asp-route-tab="shops" class="admin-nav-link active"><i class="fa-solid fa-shop"></i> Магазини</a>
        </nav>
        <div class="admin-sidebar-footer">
            <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fa-solid fa-arrow-left"></i> На сайт</a>
        </div>
    </aside>

    <main class="admin-content">
        <div class="admin-topbar">
            <div>
                <h1 class="admin-page-title">@Model.Name</h1>
                <p class="admin-page-sub">Деталі магазину</p>
            </div>
            <a asp-action="Index" asp-route-tab="shops" class="cancel-btn">
                <i class="fa-solid fa-arrow-left"></i> Назад
            </a>
        </div>

        <div class="details-grid">

            <div class="details-card">
                <h3 class="details-card-title"><i class="fa-solid fa-shop"></i> Магазин</h3>
                <div class="details-row">
                    <span class="details-label">Назва</span>
                    <span class="td-name">@Model.Name</span>
                </div>
                <div class="details-row">
                    <span class="details-label">Статус</span>
                    @if (Model.IsApproved)
                    {
                        <span class="td-status td-status-delivered">Підтверджено</span>
                    }
                    else
                    {
                        <span class="td-status td-status-pending">На розгляді</span>
                    }
                </div>
                <div class="details-row">
                    <span class="details-label">Товарів</span>
                    <span class="td-badge">@Model.Products.Count</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="details-row details-row-col">
                        <span class="details-label">Опис</span>
                        <p class="details-text">@Model.Description</p>
                    </div>
                }
            </div>

            <div class="details-card">
                <h3 class="details-card-title"><i class="fa-solid fa-user"></i> Власник</h3>
                <div class="details-row">
                    <span class="details-label">Ім'я</span>
                    <span>@(string.IsNullOrWhiteSpace(Model.OwnerFullName) ? "—" : Model.OwnerFullName)</span>
                </div>
                <div class="details-row">
                    <span class="details-label">Email</span>
                    <span class="td-email">@Model.OwnerEmail</span>
                </div>
                <div class="details-row">
                    <span class="details-label">ID</span>
                    <span class="td-id" style="font-size:12px">@Model.OwnerId</span>
                </div>
                <div class="details-row">
                    <span class="details-label">Профіль</span>
                    <a asp-action="UserDetails" asp-route-id="@Model.OwnerId" class="details-link">
                        <i class="fa-solid fa-circle-user"></i> Переглянути
                    </a>
                </div>
            </div>

        </div>

        <div class="table-wrapper">
            <div class="table-header">
                <h2 class="table-title">Товари магазину</h2>
                <span class="product-count">@Model.Products.Count товарів</span>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="admin-empty">
                    <i class="fa-solid fa-box-open"></i>
                    <p>У цьому магазині ще немає товарів</p>
                </div>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Фото</th>
                            <th>Назва</th>
                            <th>Ціна</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td class="td-id">#@p.Id</td>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/phone.jpg" : p.ImageUrl)"
                                         class="product-img" onerror="this.src='/images/phone.jpg'" />
                                </td>
                                <td>
                                    <span class="td-name">@p.Name</span>
                                    @if (!string.IsNullOrEmpty(p.Description))
                                    {
                                        <span class="td-desc">@(p.Description.Length > 60 ? p.Description[..60] + "…" : p.Description)</span>
                                    }
                                </td>
                                <td class="td-price">@p.Price.ToString("N0") ₴</td>
                                <td>
                                    <div class="actions">
                                        <a asp-action="ProductDetails" asp-route-id="@p.Id"
                                           class="info-btn" title="Деталі">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>
                                        <a asp-action="EditProduct" asp-route-id="@p.Id"
                                           class="edit-btn" title="Редагувати">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </main>
</div>
